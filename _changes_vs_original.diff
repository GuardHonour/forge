+  return {te:Math.max(0.01,Math.sqrt(v)/Math.SQRT2),source:'measured'};
+}
+/* Smallest worthwhile change: 20% of between-session spread, floored at 2.5% */
+function swc(exId){
+  const v=exHistory(exId).map(p=>p.e1).filter(x=>x>0);
+  if(v.length<4)return 0.025;
+  const m=v.reduce((a,b)=>a+b,0)/v.length;
+  if(!m)return 0.025;
+  const sd=Math.sqrt(v.reduce((a,b)=>a+(b-m)*(b-m),0)/(v.length-1));
+  return Math.max(0.025,0.2*(sd/m));
+}
+/* Progress trend, regressed on ELAPSED DAYS (not session index — a three-week
+   layoff and a three-day gap are not the same thing) and on log(e1RM), because
+   strength progress is multiplicative. Reported as % per week. */
+function liftTrend(exId,n){
+  const h=exHistory(exId).filter(p=>p.e1>0),k=n||8;
+  if(h.length<2)return null;
+  const tail=h.slice(-k);
+  if(tail.length<2)return null;
+  const t0=new Date(tail[0].date+'T00:00:00').getTime();
+  const xs=tail.map(p=>(new Date(p.date+'T00:00:00').getTime()-t0)/864e5);
+  const ys=tail.map(p=>Math.log(p.e1));
+  const span=xs[xs.length-1];
+  const perWeek=span>0?(Math.exp(slopeXY(xs,ys)*7)-1)*100:0;
+  return {n:tail.length,from:tail[0].date,to:tail[tail.length-1].date,days:span,
+    perWeek:perWeek,first:tail[0].e1,last:tail[tail.length-1].e1,
+    pct:tail[0].e1?((tail[tail.length-1].e1/tail[0].e1-1)*100):0,series:tail};
+}
+/* Stall detection that has to beat measurement noise: a change smaller than the
+   smallest worthwhile change is indistinguishable from normal variation, so we
+   say "no measurable progress yet" rather than "plateaued". */
+function stallInfo(exId){
+  const h=exHistory(exId).filter(p=>p.e1>0);
+  if(h.length<4)return {enough:false,sessions:h.length};
+  const last4=h.slice(-4),prev4=h.slice(-8,-4);
+  let best=-1,bestI=0;
+  h.forEach((p,i)=>{if(p.e1>best){best=p.e1;bestI=i}});
+  const since=h.length-1-bestI;
+  if(prev4.length<2)return {enough:false,sessions:h.length,since:since,best:best,bestDate:h[bestI].date};
+  const mxLast=Math.max.apply(null,last4.map(p=>p.e1));
+  const mxPrev=Math.max.apply(null,prev4.map(p=>p.e1));
+  const s=swc(exId),te=typicalError(exId).te;
+  const mean=last4.reduce((a,p)=>a+p.e1,0)/last4.length;
+  const within=mean>0&&last4.every(p=>Math.abs(p.e1-mean)/mean<=te);
+  return {enough:true,sessions:h.length,since:since,best:best,bestDate:h[bestI].date,
+    te:te,swc:s,mxLast:mxLast,mxPrev:mxPrev,
+    flat:(mxLast<mxPrev*(1+s))&&within};
+}
+/* Set-to-set rep decay at a fixed load. For hard sets the expected pattern is
+   roughly 70% / 55% / 50% of the first set's reps, flattening from set five.
+   Bigger drops suggest fatigue; smaller drops suggest more was in reserve. */
+const REPDROP=[1,0.70,0.55,0.50];
+function repDrop(en){
+  const sets=(en.sets||[]).filter(s=>s.r>0);
+  if(sets.length<3)return null;
+  const first=sets[0].r;
+  const ratios=[];
+  for(let i=1;i<sets.length;i++){
+    const exp=first*(REPDROP[i]!==undefined?REPDROP[i]:0.5);
+    if(exp>0)ratios.push(sets[i].r/exp);
+  }
+  if(!ratios.length)return null;
+  const avg=ratios.reduce((a,b)=>a+b,0)/ratios.length;
+  return {first:first,ratio:avg,sets:sets.map(s=>s.r),
+    note:avg<0.85?'Reps fell faster than a hard set usually does — fatigue, or not enough rest between sets.'
+      :(avg>1.15?'Reps held up better than a hard set usually does — there was probably more in reserve than reported.'
+      :'Rep behaviour is in line with genuinely hard sets.')};
+}
+/* per-lift set of derived facts used by the coach */
+function liftReport(exId){
+  const ex=EXBY[exId],h=exHistory(exId);
+  if(!h.length)return {id:exId,name:ex?ex.n:exId,n:0};
+  const last=h[h.length-1],prev=h.length>1?h[h.length-2]:null;
+  const be=bestEver(exId),tr=liftTrend(exId,8),st=stallInfo(exId);
+  return {id:exId,name:ex.n,bw:isBw(exId),n:h.length,last:last,prev:prev,
+    best:be,trend:tr,stall:st,delta:prev?last.e1-prev.e1:0};
+}
+
+/* ================= TRACKING: BODY & LOAD ================= */
+/* sessions/week actually achieved over the last n weeks (adherence to plan) */
+function adherence(n){
+  const wks=weekKeys(n||4),per=wks.map(k=>S.hist.filter(s=>mondayOf(s.date)===k).length);
+  const done=per.reduce((a,b)=>a+b,0);
+  return {perWeek:per,avg:per.length?done/per.length:0,target:(prof().days||4),weeks:wks.length};
+}
+/* acute:chronic workload ratio on weighted sets — the standard fatigue proxy.
+   Acute = last 7d, chronic = 28d weekly mean. Guarded against tiny denominators. */
+function acwr(){
+  const to=todayISO();
+  const acute=Object.values(muscleVolume(addDays(to,-6),to)).reduce((a,m)=>a+m.sets,0);
+  const chron4=Object.values(muscleVolume(addDays(to,-27),to)).reduce((a,m)=>a+m.sets,0);
+  const chronic=chron4/4;
+  return {acute:acute,chronic:chronic,ratio:chronic>1?acute/chronic:null};
+}
+/* muscle balance pairs that matter for joint health and posture */
+function balance(){
+  const to=todayISO(),from=addDays(to,-27),mv=muscleVolume(from,to);
+  const g=id=>mv[id]?mv[id].sets:0;
+  const pairs=[['chest','midback','Horizontal push : pull'],['quads','hams','Quad : hamstring'],
+               ['biceps','triceps','Elbow flexor : extensor']];
+  return pairs.map(([a,b,label])=>{
+    const x=g(a),y=g(b),r=y>0?x/y:null;
+    return {a:a,b:b,label:label,x:x,y:y,ratio:r,
+      note:r==null?'not enough data':(r>1.25?'push-biased':(r<0.8?'pull-biased':'balanced'))};
+  });
+}
+
+/* ================= VOLUME LANDMARKS & PRESCRIPTION =================
+   Weekly working-set landmarks per muscle: [MEV, MAV, MRV] = minimum
+   effective, adaptive (productive), maximum recoverable volume, scaled by
+   training level. These are programming heuristics informed by dose-response
+   research — a starting model for an individual, not a measured constant.
+   The whole engine reads them from here so they can be tuned in one place. */
+const VLM={
+ chest:      {novice:[6,12,18],intermediate:[8,15,22],advanced:[10,18,26]},
+ lats:       {novice:[6,12,18],intermediate:[8,15,22],advanced:[10,18,26]},
+ midback:    {novice:[6,12,18],intermediate:[8,15,22],advanced:[10,18,26]},
+ frontdelts: {novice:[4, 9,14],intermediate:[6,12,18],advanced:[8,15,22]},
+ sidedelts:  {novice:[4,10,16],intermediate:[6,14,22],advanced:[8,18,28]},
+ reardelts:  {novice:[4,10,16],intermediate:[6,13,20],advanced:[8,16,24]},
+ biceps:     {novice:[4, 9,14],intermediate:[6,12,18],advanced:[8,15,22]},
+ triceps:    {novice:[4, 9,14],intermediate:[6,12,18],advanced:[8,15,22]},
+ quads:      {novice:[6,12,18],intermediate:[8,15,22],advanced:[10,18,26]},
+ hams:       {novice:[5,10,16],intermediate:[7,14,20],advanced:[9,17,24]},
+ glutes:     {novice:[5,10,16],intermediate:[7,14,20],advanced:[9,17,24]},
+ calves:     {novice:[4,10,16],intermediate:[6,13,20],advanced:[8,16,24]},
+ abs:        {novice:[4, 9,14],intermediate:[6,12,18],advanced:[8,15,20]},
+};
+function landmarks(mid){
+  const t=VLM[mid];if(!t)return null;
+  const lv=prof().level||'intermediate';
+  return t[lv]||t.intermediate;
+}
+/* frequency: hypertrophy responds best to hitting a muscle ~2x/week or more */
+const FREQ_MIN=2;
+function volStatus(sets,lm){
+  if(!lm)return 'untracked';
+  if(sets<lm[0])return 'under';
+  if(sets>lm[2])return 'over';
+  if(sets>=lm[1])return 'optimal';
+  return 'ok';
+}
+/* full per-muscle picture for the last 7 days, graded against landmarks */
+function volumeCheck(){
+  const to=todayISO(),from=addDays(to,-6);
+  const mv=muscleVolume(from,to),rows=[];
+  MUSCLES.filter(m=>m.lm).forEach(m=>{
+    const v=mv[m.id],lm=landmarks(m.id);
+    rows.push({id:m.id,n:m.n,g:m.g,sets:v.sets,vol:v.vol,sess:v.sess,lm:lm,
+      status:volStatus(v.sets,lm),last:v.last,
+      pct:lm?Math.min(999,Math.round(v.sets/lm[1]*100)):0,
+      freqOk:v.sess>=FREQ_MIN});
+  });
+  return rows.sort((a,b)=>(b.sets-a.sets));
+}
+/* muscles trained hard but rarely, or barely at all — the two failure modes */
+function volumeGaps(){
+  const rows=volumeCheck();
+  const under=rows.filter(r=>r.status==='under').sort((a,b)=>a.sets-b.sets);
+  const over=rows.filter(r=>r.status==='over');
+  const infrequent=rows.filter(r=>r.sets>0&&!r.freqOk);
+  const untrained=rows.filter(r=>r.sets===0);
+  return {rows:under.concat(),under:under,over:over,infrequent:infrequent,untrained:untrained};
+}
+
+/* Is a reported effort value trustworthy enough to change the prescription?
+   Requires either a large single deviation (2+ reps, non-novice) or the same
+   direction twice running. Novices misjudge RIR by 1-2 reps, so they need the
+   repeated signal before it is allowed to move load. */
+function rirTrust(rir,prev,want){
+  if(rir===null||rir===undefined)return {ok:false,why:'no effort logged'};
+  const d=rir-want;
+  if(d===0)return {ok:false,why:'effort was exactly on target'};
+  const lvl=prof().level;
+  if(Math.abs(d)>=2&&lvl!=='novice')return {ok:true,why:'a decisive effort reading'};
+  const pd=(prev&&typeof prev.rir==='number')?prev.rir-want:null;
+  if(pd!==null&&Math.abs(pd)>=1&&((pd>0)===(d>0)))
+    return {ok:true,why:'the same effort signal appeared two sessions running'};
+  return {ok:false,why:'one effort reading is inside its own error — wait for the signal to repeat'};
+}
+/* Autoregulated next-load prescription.
+   Double progression sets the direction; reported effort (RIR) sets the size.
+   Guardrails from the evidence: never move more than 10% in one session, damp a
+   second consecutive increase to 60% of the computed change, and require the
+   same easy signal twice before allowing more than a 5% jump. */
+function nextLoad(exId){
+  const ex=EXBY[exId],d=ex.def,L=latest(exId),want=prof().rir;
