+  if(ex.bw)return {w:0,jump:0,rir:null,conf:null,note:'Bodyweight — chase reps, not load.',why:'Without external load, adding reps is the only progression available.'};
+  const sets=(L.e.sets||[]).filter(s=>s.w>0);
+  if(!sets.length)return {w:d.start,jump:0,rir:null,conf:null,note:'Log a weighted set and this becomes exact.',why:'No weighted sets recorded for this lift yet.'};
+  const mx=Math.max.apply(null,sets.map(s=>s.w));
+  const rir=(typeof L.e.rir==='number')?L.e.rir:null;
+  const h=exHistory(exId),prevS=h.length>=2?h[h.length-2]:null;
+  /* A logged override wins for the day it was made: the user's call is data,
+     not something to argue with. */
+  if(S.over&&S.over[exId]===todayISO())
+    return {w:mx,jump:0,rir:rir,conf:e1conf(mx,Math.max.apply(null,sets.map(s=>s.r)),rir),
+      delta:null,trust:{ok:false,why:'you overrode this one'},override:true,from:mx,pct:0,
+      note:'You chose to hold this load — recorded, and I will not argue.',
+      why:'Overrides are kept as training data. Repeat the load deliberately and see how it feels.'};
+  /* Effort is a SOFT input. A single RIR reading sits inside its own error
+     (~1 rep, worse the further from failure and worse for novices), so it only
+     steers the prescription when the signal is strong or has repeated. When it
+     is not trustworthy the rep range alone decides, and we say so. */
+  const trust=rirTrust(rir,prevS,want);
+  const delta=trust.ok?(rir-want):null;
+  const allTop=sets.every(s=>s.r>=d.max);
+  const anyLow=sets.some(s=>s.r<d.min);
+  let factor=1,note='',why='';
+  if(allTop){
+    if(delta!==null&&delta>=2){factor=1.075;note='Topped the range with '+rir+' still in reserve — take the double jump.';why='Every set reached '+d.max+' reps with effort to spare, so the load is well under your capacity.'}
+    else if(delta!==null&&delta<=-1){factor=1+(d.inc/mx)*0.5;note='Topped the range but it cost you — smaller jump, rebuild the reps.';why='You hit the rep target close to maximal effort, so a full increment may not hold.'}
+    else{factor=1+(d.inc/mx);note='Hit '+d.max+'s across — add '+fw(d.inc)+' '+wl()+' next time.';why='Every set reached the top of the rep range: that is the trigger to buy more weight.'}
+  }else if(anyLow){
+    if(delta!==null&&delta>=2){note='Reps fell but you had '+rir+' left — hold the load and actually push.';why='Missing the rep floor while reporting reserve effort suggests the sets ended early, not that the load is too heavy.'}
+    else if(delta!==null&&delta<=-1){factor=0.95;note='Grinding and short of reps — back off about 5% and rebuild.';why='Maximal effort with missed reps is a fatigue signal, not a strength signal.'}
+    else{note='Own the form · same load, chase the rep floor.';why='Technique before load — repeating the weight is the right move.'}
+  }else{
+    note='Same load · chase reps until every set reaches '+d.max+'.';
+    why='You are inside the rep range, so reps are the cheapest progression available.';
+  }
+  /* an increase above 5% needs the same easy signal two sessions running */
+  if(factor>1.05){
+    const prevEasy=prevS&&prevS.rir!==null&&(prevS.rir-want)>=2;
+    if(!prevEasy){factor=1.05;note='One clear jump this time — repeat it next session before going bigger.';why='A single easy session is weak evidence; two in a row is a pattern worth acting on.'}
+  }
+  /* damp a second consecutive increase */
+  if(factor>1&&prevS&&prevS.top&&mx>prevS.top.w+0.001){
+    const damped=mx+(mx*factor-mx)*0.6;
+    factor=damped/mx;
+  }
+  factor=Math.max(0.90,Math.min(1.10,factor));
+  const w=r125(mx*factor);
+  return {w:w,jump:(w>mx?1:(w<mx?-1:0)),rir:rir,conf:e1conf(mx,Math.max.apply(null,sets.map(s=>s.r)),rir),
+    delta:delta,trust:trust,note:note,why:why,from:mx,pct:mx?Math.round((w/mx-1)*1000)/10:0};
+}
+/* Warm-up ramp to a working load. Ramp sets stay well short of failure
+   (RPE ~5-6) or they cost you the working sets they were meant to prepare. */
+function warmupRamp(kg){
+  if(!kg||kg<=0)return [];
+  const steps=[[0.45,8],[0.62,5],[0.78,3],[0.88,2]];
+  const out=[];let prev=0;
+  steps.forEach(([p,r])=>{const w=r125(kg*p);if(w>prev&&w<kg){out.push({w:w,r:r});prev=w}});
+  return out;
+}
+/* Session internal load (Foster-style): effort x duration. Reported as an
+   index of your own trend, never as an absolute or a risk score. */
+function sessionLoad(s,rpe){
+  const mins=Math.max(1,Math.round((s.dur||0)/60));
+  if(typeof s.rpe==='number')return s.rpe*mins;
+  const mv=s.entries.reduce((a,e)=>a+e.sets.length,0);
+  return Math.min(10,4+mv*0.35)*mins;   /* derived proxy when RPE was not logged */
+}
+function loadTrend(weeks){
+  const n=weeks||6,wks=weekKeys(n),map={};
+  wks.forEach(k=>map[k]={load:0,n:0});
+  S.hist.forEach(s=>{const k=mondayOf(s.date);if(map[k]){map[k].load+=sessionLoad(s);map[k].n++}});
+  return wks.map(k=>({week:k,load:Math.round(map[k].load),n:map[k].n}));
+}
+/* week-on-week change in volume load — a more defensible flag than ACWR */
+function rampCheck(){
+  const lt=loadTrend(4),cur=lt[lt.length-1],prev=lt[lt.length-2];
+  if(!prev||!prev.load||!cur.load)return {pct:null,note:'not enough history'};
+  const pct=(cur.load/prev.load-1)*100;
+  return {pct:Math.round(pct),note:pct>30?'ramping fast':(pct<-30?'sharp drop':'steady')};
+}
+/* e1RM versus its own 28-day baseline: a >=3% drop is a readiness signal */
+function e1Baseline(exId){
+  const h=exHistory(exId);if(!h.length)return null;
+  const cur=h[h.length-1],cut=addDays(todayISO(),-28);
+  const prior=h.filter(p=>p.date>=cut&&p.date<cur.date);
+  if(!prior.length)return null;
+  const base=prior.reduce((a,p)=>a+p.e1,0)/prior.length;
+  if(!base)return null;
+  const pct=(cur.e1/base-1)*100;
+  return {cur:cur.e1,base:base,pct:pct,drop:pct<=-3};
+}
+
+/* ================= COACH: DIAGNOSIS ================= */
+const scoreOf=en=>isBw(en.id)?en.sets.reduce((a,s)=>a+s.r,0):bestE1(en);
+function allLifts(){const o={};S.hist.forEach(s=>s.entries.forEach(e=>{if(e.sets&&e.sets.length)o[e.id]=1}));return Object.keys(o)}
+/* genuine PBs only: a first-ever session is a baseline, not a record */
+function recentPRs(days){
+  const cut=addDays(todayISO(),-(days||28)),out=[],best={};
+  S.hist.slice().sort((a,b)=>(a.date<b.date?-1:1)).forEach(s=>{
+    s.entries.forEach(en=>{
+      if(!en.sets||!en.sets.length)return;
+      const sc=scoreOf(en),prev=best[en.id]||0;
+      if(s.date>=cut&&prev>0&&sc>prev+0.01)out.push({date:s.date,id:en.id,name:EXBY[en.id].n,score:sc,delta:sc-prev,bw:isBw(en.id)});
+      if(sc>prev)best[en.id]=sc;
+    });
+  });
+  return out.sort((a,b)=>(a.date<b.date?1:-1));
+}
+function readiness(){
+  const last=S.hist.length?S.hist[S.hist.length-1]:null;
+  const days=last?Math.max(0,Math.round((new Date(todayISO()+'T00:00:00')-new Date(last.date+'T00:00:00'))/864e5)):null;
+  const ac=acwr();
+  let level='green',label='Ready to push',msg='';
+  if(days===null){level='grey';label='No data yet';msg='Log a session and this becomes your training dashboard.'}
+  else if(ac.ratio!==null&&ac.ratio>1.5){level='red';label='Back off';msg='You have stacked volume faster than you have recovered from it.'}
+  else if(days===0){level='amber';label='Trained today';msg='Already trained. Recovery is where the adaptation happens.'}
+  else if(days<=1){level='green';label='Fresh';msg='A day or less since your last session.'}
+  else if(days<=3){level='green';label='Ready to push';msg=days+' days since your last session — a good window to train hard.'}
+  else{level='amber';label='Returning';msg=days+' days since your last session. Expect some detraining; do not chase old numbers on day one.'}
+  return {level:level,label:label,msg:msg,days:days,acwr:ac};
+}
+/* Deload is a SUGGESTION, never automatic, and deliberately mild. The evidence
+   for scheduled deloading is weak (the best RCT found continuous training
+   marginally ahead on strength and readiness), while real-world practice cuts
+   volume only 0-25% and keeps frequency unchanged. So this offers a one-week
+   experiment with a defined end — not a prescription, and never a 50% cut. */
+function deloadCheck(){
+  const lifts=allLifts().map(liftReport).filter(l=>l.n>=3&&l.stall&&l.stall.enough);
+  const flat=lifts.filter(l=>l.stall.flat);
+  const rc=rampCheck(),reasons=[];
+  if(flat.length>=3)reasons.push(flat.length+' lifts show no measurable progress at the same time.');
+  else if(flat.length===2)reasons.push('Two lifts show no measurable progress together.');
+  if(rc.pct!==null&&rc.pct>30)reasons.push('Your volume load rose '+rc.pct+'% week on week.');
+  return {suggest:reasons.length>0,reasons:reasons,flat:flat,
+    plan:'One lighter week: cut sets by about 20% (not half), keep the same exercises and the same training frequency — do not drop sessions — and let effort drift to 3-4 reps in reserve.',
+    caveat:'Deloading is widespread practice but is not established by trials — treat it as a one-week experiment with a defined end, not a rule.'};
+}
+function diagnose(){
+  const g=volumeGaps(),ac=acwr(),rd=readiness(),dl=deloadCheck(),pf=prof();
+  const stalls=allLifts().map(liftReport).filter(l=>l.stall&&l.stall.stalled).sort((a,b)=>b.stall.since-a.stall.since);
+  const bal=balance(),adh=adherence(4),actions=[];
+  if(dl.suggest)actions.push({tone:'warn',icon:'M12 8v5M12 16.5v.5',title:'Consider a lighter week',
+    detail:dl.reasons.join(' ')+' '+dl.plan,why:dl.caveat});
+  const unt=g.untrained;
+  if(unt.length)actions.push({tone:'warn',icon:'M12 5v14M5 12h14',title:'No work logged for '+unt.slice(0,3).map(u=>u.n).join(', '),
+    detail:'Zero working sets in the last 7 days.',why:'A muscle you never train cannot grow, however hard you train the rest.'});
+  const under=g.under.filter(u=>u.sets>0);
+  if(under.length)actions.push({tone:'',icon:'M12 19V5M5 12l7-7 7 7',title:'Add volume to '+under.slice(0,3).map(u=>u.n).join(', '),
+    detail:under.slice(0,3).map(u=>u.n+' '+u.sets+' vs '+u.lm[0]+' minimum').join(' · '),why:'Below the minimum effective volume a muscle is roughly maintaining, not growing.'});
